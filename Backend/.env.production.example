# Example environment for production (Render, Docker, etc.).
# Copy and set real values on your host — never commit secrets.

DJANGO_SETTINGS_MODULE=smartreview_backend.settings_prod
DJANGO_SECRET_KEY=replace-with-get_random_secret_key-output
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_SSL_REQUIRE=true

ALLOWED_HOSTS=your-api.onrender.com
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

SECURE_SSL_REDIRECT=true

# Email (optional)
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
