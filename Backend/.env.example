# Copy this file to .env and fill in your values.
# NEVER commit .env to Git - it contains secrets.

# Gmail SMTP (for OTP verification emails)
# Use App Password from https://myaccount.google.com/apppasswords (requires 2FA)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# OTP expiry in minutes
OTP_EXPIRY_MINUTES=2

# If you get "getaddrinfo failed" (DNS/network issue), uncomment below.
# OTP will print in terminal instead of sending email.
# USE_CONSOLE_EMAIL=1
